# ═══════════════════════════════════════════════════════════════
# v2 BIG BANG — variables de entorno. Copia esto a .env.local
# (nunca se sube a git). Sin SUPABASE_* la app corre en modo v1 puro.
# ═══════════════════════════════════════════════════════════════

# ── Supabase (Project Settings → API) ──────────────────────────
# Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# service_role — SECRETA, solo server. Jamás la pongas en NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Sesiones (participante + admin) ────────────────────────────
# Genera una:  openssl rand -base64 32
SESSION_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# ── URL pública de la app ──────────────────────────────────────
# Es la base de los magic links /a/<token> y del editor admin.
APP_URL=http://localhost:3000

# ── Resend (email transaccional, decisión D3) ──────────────────
# Mientras el dominio no esté verificado usa el sandbox:
# RESEND_FROM="TEA Admisiones <onboarding@resend.dev>"
RESEND_API_KEY=re_...
RESEND_FROM="TEA Admisiones <onboarding@resend.dev>"

# ── v1 CRM FunnelUp/GoHighLevel (opcional en v2) ───────────────
# Solo se usa si activas la integración CRM en /admin/integraciones
# (los writes al CRM van por la cola outbound_queue, no bloqueante).
GHL_API_KEY=tu_token_de_api_de_funnelup
GHL_LOCATION_ID=9cXtL7yJiTR3U0C2xmDt

# ── Admin (Estrato 3) ──────────────────────────────────────────
# El primer login de ESTE correo se auto-alta como 'owner' del tenant.
# Después puedes borrarlo o dejarlo; también puedes dar de alta admins
# a mano: Authentication → Users → Add user + INSERT en admin_users.
ADMIN_BOOTSTRAP_EMAIL=admin@tu-dominio.com

# ── Conectores (Estrato 4) ─────────────────────────────────────
# Secret que Vercel Cron manda a /api/cron/outbound cada 5 minutos.
# Genera:  openssl rand -hex 24
CRON_SECRET=cambia_esto_por_un_secret_largo
# Secret alternativo (env) para el webhook de entrada /api/intake/lead.
# Si lo guardas en /admin/integraciones (DB) tiene prioridad local.
INTAKE_SECRET=

# ── Tenant por defecto para scripts admin e intake ─────────────
TENANT_SLUG=tea
